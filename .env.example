# Logging Configuration
LOG_LEVEL=info
LOG_JSON=false

# Server Configuration
BUCKET_NAME=default
LISTEN_ADDRESS=0.0.0.0
LISTEN_PORT=8080

# KV Storage Configuration
KVSTORAGE_TYPE=sqlite
# For SQLite:
SQLITE_PATH=/app/data/kv.db
SQLITE_MAX_CONNECTIONS=10

# For PostgreSQL (if using postgres):
# KVSTORAGE_TYPE=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=s3dedup
# POSTGRES_MAX_CONNECTIONS=10

# Lock Manager Configuration
LOCKS_TYPE=memory

# S3 Storage Configuration (Garage - credentials set up automatically by docker-compose)
S3STORAGE_TYPE=s3
S3_ENDPOINT=http://garage:3900
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
S3_FORCE_PATH_STYLE=true

# Cleaner Configuration
CLEANER_ENABLED=true
CLEANER_INTERVAL=3600
CLEANER_BATCH_SIZE=1000
CLEANER_MAX_DELETES=10000

# Live Migration (optional)
# FILETRACKER_URL=http://old-filetracker:8000
