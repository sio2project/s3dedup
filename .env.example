# Logging Configuration
LOG_LEVEL=info
LOG_JSON=false
# JSON_LOG_PATH=/var/log/s3dedup.json  # Dual output: pretty stdout + JSON file

# Server Configuration
BUCKET_NAME=default
LISTEN_ADDRESS=0.0.0.0
LISTEN_PORT=8080

# KV Storage Configuration
KVSTORAGE_TYPE=sqlite
# For SQLite:
SQLITE_PATH=/app/data/kv.db
SQLITE_MAX_CONNECTIONS=10

# For PostgreSQL (if using postgres):
# KVSTORAGE_TYPE=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=s3dedup
# POSTGRES_MAX_CONNECTIONS=10

# Lock Manager Configuration
LOCKS_TYPE=memory

# S3 Storage Configuration (Garage - credentials set up automatically by docker-compose)
S3_ENDPOINT=http://garage:3900
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
S3_FORCE_PATH_STYLE=true
S3_REGION=garage
# S3_KEY_SHARDING_ENABLED=true   # Distribute objects into subdirectories (default: true)
# S3_KEY_SHARDING_DEPTH=2        # Number of sharding levels (default: 2)

# Upload Configuration
# MAX_INMEMORY_SIZE=67108864      # Max file size in memory before spilling to disk (default: 64MB)
# TEMP_DIR=/tmp                   # Directory for temporary files (default: system temp dir)

# Cleaner Configuration
CLEANER_ENABLED=true
CLEANER_INTERVAL=3600
CLEANER_BATCH_SIZE=1000
CLEANER_CONCURRENCY=8
# CLEANER_FULL_SCAN_CRON=0 3 * * *  # Full S3 scan schedule (5-field cron, optional)

# Live Migration (optional)
# FILETRACKER_URL=http://old-filetracker:8000
# FILETRACKER_V1_DIR=/path/to/v1/filetracker
