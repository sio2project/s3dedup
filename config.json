{
  "logging": {
    "level": "debug",
    "json": false
  },
  "kvstorage_type": "sqlite",
  "sqlite": {
    "path": "db/kv.db",
    "pool_size": 10
  },
  "locks_type": "memory",
  "bucket": {
    "name": "default",
    "address": "0.0.0.0",
    "port": 8080,
    "s3storage_type": "s3",
    "s3": {
      "endpoint": "http://localhost:3900",
      "access_key": "GK0123456789abcdef01234567",
      "secret_key": "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
      "force_path_style": true,
      "region": "garage"
    },
    "cleaner": {
      "enabled": false,
      "interval_seconds": 3600,
      "batch_size": 1000,
      "max_deletes_per_run": 10000
    }
  }
}
