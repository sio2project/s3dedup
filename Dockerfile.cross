# Build stage - cross-compile from x86_64
FROM --platform=linux/amd64 rustlang/rust:nightly-slim as builder

ARG TARGETARCH

WORKDIR /usr/src/s3dedup

# Install cross-compilation dependencies
RUN dpkg --add-architecture arm64 && \
    apt-get update && \
    apt-get install -y \
    pkg-config \
    libssl-dev \
    perl \
    make \
    gcc-aarch64-linux-gnu \
    libc6-dev-arm64-cross \
    && rm -rf /var/lib/apt/lists/*

# Add Rust target for ARM64
RUN rustup target add aarch64-unknown-linux-gnu

# Copy manifests
COPY Cargo.toml Cargo.lock ./

# Copy source code
COPY src ./src
COPY tests ./tests

# Configure cross-compilation linker
RUN mkdir -p .cargo && \
    echo '[target.aarch64-unknown-linux-gnu]' >> .cargo/config.toml && \
    echo 'linker = "aarch64-linux-gnu-gcc"' >> .cargo/config.toml

# Build for the target architecture
RUN if [ "$TARGETARCH" = "arm64" ]; then \
      cargo build --release --target aarch64-unknown-linux-gnu && \
      cp target/aarch64-unknown-linux-gnu/release/s3dedup target/release/s3dedup; \
    else \
      cargo build --release; \
    fi

# Runtime stage - use correct platform
FROM debian:trixie-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Copy the binary from builder
COPY --from=builder /usr/src/s3dedup/target/release/s3dedup /usr/local/bin/s3dedup

# Create directory for config and database
RUN mkdir -p /app/data

# Set the working directory where config.json should be placed
WORKDIR /app

# Expose default port (can be overridden in config)
EXPOSE 8080

# Run the server command with environment variables by default
ENTRYPOINT ["s3dedup"]
CMD ["server", "--env"]
